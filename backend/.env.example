# Postgres connection string used by Prisma
DATABASE_URL="postgresql://aawcs:aawcs_dev_password@localhost:5432/aawcs?schema=public"

# Secret used to sign session JWTs — generate your own for anything beyond local dev:
#   openssl rand -hex 32
JWT_SECRET="dev-only-change-me"

# How long an issued session token stays valid
JWT_EXPIRES_IN="12h"

# Default OTP for local/dev login (see README — replace with real email delivery for production)
DEV_OTP_CODE="123456"

# How long a requested OTP stays valid, in minutes
OTP_TTL_MINUTES="10"

# How long an issued QR gate code stays valid, in seconds
QR_TOKEN_TTL_SECONDS="90"

PORT="4000"

# Comma-separated list of origins allowed to call this API (your SvelteKit dev server, etc.)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
